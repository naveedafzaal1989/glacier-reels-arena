<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-RN window background. On a loaded emulator the JS bundle needs ~8s to
  paint LoaderScreen; until then this drawable is the whole screen, so it has
  to read as the app's own splash (glacier gradient + cyan brand ring), not as
  a flat black rectangle. Mirrors LoaderScreen's palette and brand mark.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- glacier gradient, same stops as LoaderScreen's overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/splashDeep"
                android:centerColor="@color/splashMid"
                android:endColor="@color/splashBackground" />
        </shape>
    </item>

    <!-- aurora halo behind the mark -->
    <item android:gravity="center" android:width="300dp" android:height="300dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:startColor="#385AD1E8"
                android:endColor="#005AD1E8" />
        </shape>
    </item>

    <!-- brand disc: same 184dp cyan ring LoaderScreen draws -->
    <item android:gravity="center" android:width="184dp" android:height="184dp">
        <shape android:shape="oval">
            <solid android:color="#E00A2235" />
            <stroke android:width="3dp" android:color="@color/splashRing" />
        </shape>
    </item>

    <!-- inner hairline ring -->
    <item android:gravity="center" android:width="132dp" android:height="132dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#59D6F3FF" />
        </shape>
    </item>

    <!-- glowing core of the brand mark (the launcher icon is deliberately NOT
         used here: it is the procedural placeholder and its palette clashes) -->
    <item android:gravity="center" android:width="84dp" android:height="84dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="42dp"
                android:startColor="#B35AD1E8"
                android:endColor="#1A5AD1E8" />
        </shape>
    </item>

    <item android:gravity="center" android:width="44dp" android:height="44dp">
        <shape android:shape="oval">
            <solid android:color="#F2D6F3FF" />
        </shape>
    </item>

    <!-- progress-bar stand-in, echoes the LoaderScreen track -->
    <item
        android:gravity="center_horizontal|bottom"
        android:width="212dp"
        android:height="5dp"
        android:bottom="220dp">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#285AD1E8" />
        </shape>
    </item>

</layer-list>
