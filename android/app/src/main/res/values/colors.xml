<resources>
    <!-- Splash background — kept dark so the pre-RN window before the JS bundle
         loads matches the in-app loader instead of flashing white.
         Each generated app's LoaderScreen will paint over this anyway, but the
         pre-bridge frame uses this value, which is what the user sees first. -->
    <color name="splashBackground">#04101C</color>
    <!-- Glacier gradient stops + brand ring used by @drawable/splash_screen. -->
    <color name="splashDeep">#02070E</color>
    <color name="splashMid">#0B2B45</color>
    <color name="splashRing">#5AD1E8</color>
</resources>
